// ============================================================
// SmartFarm ERP — Prisma Schema v3.0 (Prisma 7 uyumlu)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  EMAIL_VERIFY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  TOKEN_REFRESH
}

enum ZoneType {
  GREENHOUSE
  FIELD
  BARN
  STORAGE
  OFFICE
  OTHER
}

enum CropStatus {
  PLANNED
  GROWING
  HARVESTED
  FAILED
  CANCELLED
}

enum DeviceType {
  ESP32
  SENSOR
  RELAY
  CAMERA
  GATEWAY
}

enum SensorType {
  TEMPERATURE
  HUMIDITY
  PH
  EC
  AMMONIA
  WATER_LEVEL
  CO2
  LIGHT
  SOIL_MOISTURE
  MOTION
  PRESSURE
}

enum AnimalStatus {
  HEALTHY
  PREGNANT
  SICK
  QUARANTINE
  SOLD
  DEAD
}

enum Gender {
  MALE
  FEMALE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  IRRIGATION
  FERTILIZATION
  HARVESTING
  MAINTENANCE
  VETERINARY
  FEEDING
  INSPECTION
  CLEANING
  PLANTING
  SPRAYING
  GENERAL
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  PARTNER
  VETERINARY
  LABORATORY
  GOVERNMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum NotificationChannel {
  TELEGRAM
  EMAIL
  SMS
  PUSH
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ============================================================
// AUTH & KULLANICI
// ============================================================

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  phone              String?    @unique
  passwordHash       String
  name               String
  surname            String
  avatar             String?
  status             UserStatus @default(ACTIVE)
  twoFASecret        String?
  twoFAEnabled       Boolean    @default(false)
  twoFARecoveryCodes String[]
  telegramId         String?    @unique
  telegramUsername   String?
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id])
  lastLoginAt        DateTime?
  lastLoginIp        String?
  loginAttempts      Int        @default(0)
  lockedUntil        DateTime?
  tokens             UserToken[]
  auditLogs          AuditLog[]
  assignedTasks      Task[]     @relation("TaskAssignee")
  createdTasks       Task[]     @relation("TaskCreator")
  staffProfile       StaffProfile?
  notifications      Notification[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  @@index([email])
  @@index([telegramId])
  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  module   String
  action   String
  resource String @default("*")
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([module, action, resource, roleId])
  @@map("permissions")
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("user_tokens")
}

// ============================================================
// TARIM
// ============================================================

model Farm {
  id          String     @id @default(cuid())
  name        String
  description String?
  address     String?
  latitude    Float?
  longitude   Float?
  totalArea   Float?
  ownerId     String
  zones       FarmZone[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("farms")
}

model FarmZone {
  id          String     @id @default(cuid())
  name        String
  type        ZoneType
  description String?
  area        Float?
   farmId      String?
  farm        Farm?      @relation(fields: [farmId], references: [id])
  devices     Device[]
  crops       Crop[]
  animals     Animal[]
  tasks       Task[]
  stocks      Stock[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("farm_zones")
}

model Crop {
  id              String         @id @default(cuid())
  name            String
  variety         String?
  plantDate       DateTime?
  expectedHarvest DateTime?
  actualHarvest   DateTime?
  status          CropStatus     @default(PLANNED)
  area            Float?
  notes           String?
  zoneId       String?
  zone         FarmZone?    @relation(fields: [zoneId], references: [id])
  harvests        Harvest[]
  irrigations     Irrigation[]
  fertilizations  Fertilization[]
  sprayings       Spraying[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("crops")
}

model Harvest {
  id          String   @id @default(cuid())
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id])
  quantity    Float
  unit        String   @default("kg")
  quality     String?
  price       Decimal? @db.Decimal(10,2)
  notes       String?
  harvestedAt DateTime
  createdAt   DateTime @default(now())

  @@map("harvests")
}

model Irrigation {
  id          String   @id @default(cuid())
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id])
  amount      Float
  unit        String   @default("litre")
  duration    Int?
  ph          Float?
  ec          Float?
  notes       String?
  irrigatedAt DateTime
  createdAt   DateTime @default(now())

  @@map("irrigations")
}

model Fertilization {
  id             String   @id @default(cuid())
  cropId         String
  crop           Crop     @relation(fields: [cropId], references: [id])
  fertilizerName String
  amount         Float
  unit           String   @default("ml")
  notes          String?
  fertilizedAt   DateTime
  createdAt      DateTime @default(now())

  @@map("fertilizations")
}

model Spraying {
  id          String   @id @default(cuid())
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id])
  productName String
  amount      Float
  unit        String   @default("ml")
  reason      String?
  notes       String?
  sprayedAt   DateTime
  createdAt   DateTime @default(now())

  @@map("sprayings")
}

// ============================================================
// HAYVANCILIK
// ============================================================

model Animal {
  id           String       @id @default(cuid())
  earTag       String       @unique
  rfid         String?      @unique
  name         String?
  species      String
  breed        String?
  gender       Gender
  birthDate    DateTime?
  weight       Float?
  status       AnimalStatus @default(HEALTHY)
  notes        String?
  photo        String?
   zoneId       String?
  zone         FarmZone?    @relation(fields: [zoneId], references: [id])
  vaccinations Vaccination[]
  pregnancies  Pregnancy[]
  weightLogs   WeightLog[]
  treatments   Treatment[]
  feedLogs     FeedLog[]
  tasks        Task[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([earTag])
  @@index([status])
  @@map("animals")
}

model Vaccination {
  id           String    @id @default(cuid())
  animalId     String
  animal       Animal    @relation(fields: [animalId], references: [id])
  vaccineName  String
  dose         Float?
  unit         String?
  batchNo      String?
  nextDue      DateTime?
  veterinary   String?
  notes        String?
  vaccinatedAt DateTime
  createdAt    DateTime  @default(now())

  @@map("vaccinations")
}

model Pregnancy {
  id             String    @id @default(cuid())
  animalId       String
  animal         Animal    @relation(fields: [animalId], references: [id])
  matingDate     DateTime?
  expectedBirth  DateTime?
  actualBirth    DateTime?
  offspringCount Int?
  offspringAlive Int?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("pregnancies")
}

model WeightLog {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  weight     Float
  unit       String   @default("kg")
  notes      String?
  measuredAt DateTime
  createdAt  DateTime @default(now())

  @@map("weight_logs")
}

model Treatment {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  diagnosis  String
  medicine   String
  dose       Float?
  unit       String?
  duration   Int?
  veterinary String?
  cost       Decimal? @db.Decimal(10,2)
  notes      String?
  treatedAt  DateTime
  createdAt  DateTime @default(now())

  @@map("treatments")
}

model FeedLog {
  id       String   @id @default(cuid())
  animalId String
  animal   Animal   @relation(fields: [animalId], references: [id])
  feedType String
  amount   Float
  unit     String   @default("kg")
  notes    String?
  fedAt    DateTime
  createdAt DateTime @default(now())

  @@map("feed_logs")
}

// ============================================================
// IoT / SCADA
// ============================================================

model Device {
  id           String      @id @default(cuid())
  mac          String      @unique
  name         String
  type         DeviceType
  location     String?
  firmwareVer  String?
  ipAddress    String?
  rssi         Int?
  batteryLevel Int?
  isOnline     Boolean     @default(false)
  lastSeen     DateTime?
  farmZoneId   String?
  farmZone     FarmZone?   @relation(fields: [farmZoneId], references: [id])
  sensors      Sensor[]
  relays       Relay[]
  readings     SensorReading[]
  alerts       DeviceAlert[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([mac])
  @@index([isOnline])
  @@map("devices")
}

model Sensor {
  id        String          @id @default(cuid())
  name      String
  type      SensorType
  unit      String
  pin       Int?
  minAlert  Float?
  maxAlert  Float?
  deviceId  String
  device    Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings  SensorReading[]
  createdAt DateTime        @default(now())

  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  value     Float
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@index([sensorId, timestamp])
  @@index([deviceId, timestamp])
  @@map("sensor_readings")
}

model Relay {
  id       String  @id @default(cuid())
  name     String
  pin      Int
  state    Boolean @default(false)
  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("relays")
}

model DeviceAlert {
  id           String   @id @default(cuid())
  severity     String
  message      String
  acknowledged Boolean  @default(false)
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id])
  createdAt    DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("device_alerts")
}

// ============================================================
// GÖREV
// ============================================================

model Task {
  id               String         @id @default(cuid())
  title            String
  description      String?
  type             TaskType       @default(GENERAL)
  priority         TaskPriority   @default(MEDIUM)
  status           TaskStatus     @default(PENDING)
  dueDate          DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  completedAt      DateTime?
  completionNote   String?
  gpsLat           Float?
  gpsLng           Float?
  photos           String[]
  tags             String[]
  telegramMsgId    String?
  recurrence       RecurrenceType @default(NONE)
  recurrenceDays   Int[]
  assigneeId       String?
  assignee         User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById      String
  createdBy        User           @relation("TaskCreator", fields: [createdById], references: [id])
  farmZoneId       String?
  farmZone         FarmZone?      @relation(fields: [farmZoneId], references: [id])
  animalId         String?
  animal           Animal?        @relation(fields: [animalId], references: [id])
  checklist        ChecklistItem[]
  attachments      Attachment[]
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, dueDate])
  @@index([assigneeId, status])
  @@map("tasks")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  size      Int?
  mimeType  String?
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())

  @@map("attachments")
}

// ============================================================
// CRM
// ============================================================

model Contact {
  id           String        @id @default(cuid())
  type         ContactType
  name         String
  company      String?
  email        String?
  phone        String?
  address      String?
  taxNo        String?
  notes        String?
  tags         String[]
  isActive     Boolean       @default(true)
  transactions Transaction[]
  notes_rel    ContactNote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([type])
  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(cuid())
  content   String
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("contact_notes")
}

// ============================================================
// PERSONEL
// ============================================================

model StaffProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  title            String?
  department       String?
  startDate        DateTime?
  salary           Decimal?     @db.Decimal(10,2)
  idNumber         String?
  emergencyContact String?
  skills           String[]
  leaves           Leave[]
  attendances      Attendance[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("staff_profiles")
}

model Leave {
  id         String       @id @default(cuid())
  staffId    String
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String       @default("PENDING")
  approvedBy String?
  createdAt  DateTime     @default(now())

  @@map("leaves")
}

model Attendance {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id])
  checkIn   DateTime
  checkOut  DateTime?
  gpsLat    Float?
  gpsLng    Float?
  notes     String?
  createdAt DateTime     @default(now())

  @@map("attendances")
}

// ============================================================
// STOK
// ============================================================

model StockCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  unit   String
  stocks Stock[]

  @@map("stock_categories")
}

model Stock {
  id          String        @id @default(cuid())
  name        String
  code        String?       @unique
  categoryId  String
  category    StockCategory @relation(fields: [categoryId], references: [id])
  quantity    Float         @default(0)
  unit        String
  minQuantity Float?
  price       Decimal?      @db.Decimal(10,2)
  location    String?
  zoneId      String?
  zone        FarmZone?     @relation(fields: [zoneId], references: [id])
  movements   StockMovement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([code])
  @@map("stocks")
}

model StockMovement {
  id          String            @id @default(cuid())
  stockId     String
  stock       Stock             @relation(fields: [stockId], references: [id])
  type        StockMovementType
  quantity    Float
  unitPrice   Decimal?          @db.Decimal(10,2)
  reason      String?
  contactId   String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([stockId, createdAt])
  @@map("stock_movements")
}

// ============================================================
// FİNANS
// ============================================================

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(12,2)
  currency    String          @default("TRY")
  description String?
  date        DateTime
  invoiceNo   String?
  contactId   String?
  contact     Contact?        @relation(fields: [contactId], references: [id])
  attachments String[]
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, date])
  @@map("transactions")
}

// ============================================================
// BAKIM
// ============================================================

model MaintenanceRecord {
  id           String            @id @default(cuid())
  title        String
  description  String?
  status       MaintenanceStatus @default(SCHEDULED)
  scheduledAt  DateTime
  completedAt  DateTime?
  cost         Decimal?          @db.Decimal(10,2)
  deviceId     String?
  technicianId String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("maintenance_records")
}

// ============================================================
// BİLDİRİM
// ============================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  message   String
  data      Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, status])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  module     String
  entityId   String?
  entityType String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  timestamp  DateTime    @default(now())

  @@index([userId, timestamp])
  @@index([module, action])
  @@map("audit_logs")
}
